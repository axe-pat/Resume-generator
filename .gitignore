# OS / editor noise
.DS_Store
.Rhistory
.idea/
.vscode/

# Secrets / local config
.env
.env.*

# Python caches / environments
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
venv/
.venv/

# Node dependencies
node_modules/

# Logs and runtime lock files
logs/
*.log
*.lock

# Excel / Office temp files
~$*

# Local job tracker and backups
discovery/jobs.xlsx
discovery/jobs_backup*.xlsx
discovery/~$jobs.xlsx

# Generated discovery logs and bundled vendor packages
discovery/auto/logs/
discovery/auto/*.dist-info/
discovery/auto/async_timeout/
discovery/auto/redis/
discovery/playwright/chrome-data/
discovery/source_validation/*

# Generated resume and cover-letter runs
resume/compiler/runs/
resume/freeform/runs/
cover_letters/runs/

# Apply Assist private runtime data
apply_assist/profile_answers.local.json
apply_assist/tasks/*
!apply_assist/tasks/.gitkeep
apply_assist/results/*
!apply_assist/results/.gitkeep

# Generated application outputs and archives
apps/*
!apps/README.md
!apps/.gitkeep
inactive_apps/
resume_archive/
archive/

# Personal profile assets and binary source material
profile/handcrafted_resumes/
profile/repos/
*.pdf
*.docx
*.zip

# Ignore run-native batch workspaces by default
apps/runs/**

# Local backups
discovery/jobs.xlsx.bak

# Personal interview prep
docs/interview_prep/
docs/career_workbench/interview_prep/private/
